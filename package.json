{
  "name": "dsh-plugin-bilibili",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: Bilibili keyword video search, video metadata, subtitle transcripts, direct play URLs, and multimodal frame viewing (bilibili_search / bilibili_video / bilibili_subtitles / bilibili_playurl / bilibili_frames). Anonymous by default with risk-control bootstrapping; an optional SESSDATA unlocks login-gated subtitles and higher-quality streams.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "bilibili",
    "video",
    "subtitles",
    "agent-tool",
    "vision",
    "frames",
    "multimodal"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "skills/**/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxingovo/dsh-bilibili.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "tsdown": "^0.13.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
